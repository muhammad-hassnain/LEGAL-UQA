# Copy this file to `.env` and fill in your API keys:
#   cp .env.example .env
#
# The notebooks call load_dotenv(), which reads `.env` automatically.
# `.env` is git-ignored, so your real keys are never committed.

# --- Required for the model each provider notebook uses ---
OPENAI_API_KEY=your-openai-api-key-here          # openai_qa / openai_translate / dataset generation (gpt-5)
ANTHROPIC_API_KEY=your-anthropic-api-key-here     # claude_qa / claude_translate (claude-opus-5)
MISTRAL_API_KEY=your-mistral-api-key-here         # mistral_qa / mistral_translate (mistral-large-latest)
DEEPSEEK_API_KEY=your-deepseek-api-key-here       # deepseek_qa / deepseek_translate (deepseek-chat)
GEMINI_API_KEY=your-gemini-api-key-here           # gemini / gemini_translate
JEV_API_KEY=your-jev-api-key-here                 # JEV judge for scripts/jev/* (noul-mode answer equivalence)
# TYPESAFE_API_KEY is also accepted (same value); the SDK reads whichever is set.

# --- Optional ---
# Gemma-3-4B is served locally via vLLM (no key needed); these are only the
# defaults the notebooks point at. Override if your server differs.
# VLLM_BASE_URL=http://localhost:8000/v1

# LangSmith tracing (optional; used by openai_translations.ipynb if enabled)
# LANGCHAIN_API_KEY=your-langsmith-key-here
# LANGCHAIN_TRACING_V2=true

# Hugging Face token (optional; only if you serve gated models via vLLM)
# HF_TOKEN=your-hf-token-here
